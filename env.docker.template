# Frosty VL docker-compose environment template.
# Copy to .env before running docker compose:  cp env.docker.template .env
#
# Absolute host paths. Provide your OWN Qwen3-VL-based base pipeline; this
# plugin ships no model weights.
FVL_MODEL_DIR=/srv/frosty-vl/models/base-pipeline
FVL_OUTPUT_DIR=/srv/frosty-vl/outputs
FVL_MODEL_REVISION=main
FVL_WAN_MODEL_DIR=/srv/frosty-vl/models/Wan2.2-TI2V-5B-Diffusers

# Host bindings. Keep the raw API private unless it is protected upstream.
FVL_API_BIND=127.0.0.1
FVL_PORT=8899
FVL_PUBLIC_BASE=http://127.0.0.1:8899
# Keep loopback unless the operator supplies a private VPN/WireGuard address.
FVL_UI_BIND=127.0.0.1
FVL_UI_PORT=8890
FVL_GALLERY_LIMIT=200

FVL_FL_GPU=0
FVL_REF_GPU=1
FVL_WAN_GPU=2
FVL_GEN_TIMEOUT=2400

# Projection strengths — safe release: golden-safety floor ON.
FVL_ABL_LAM=3.0
FVL_SAFETY_LAM=3.0
