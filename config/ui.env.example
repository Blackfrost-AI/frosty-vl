# Change this to the GPU VM's private/WireGuard address.
FVL_BASE=http://127.0.0.1:8899
FVL_UI_HOST=127.0.0.1
FVL_UI_PORT=8890

# Long 10–14 second renders can exceed 15 minutes.
FVL_GEN_TIMEOUT=2400
FVL_FFMPEG=/usr/bin/ffmpeg

# Use the same persistent directory configured as FVL_SERVE_OUT on the server.
FVL_GALLERY_DIR=/srv/frosty-vl/outputs
FVL_GALLERY_LIMIT=200

# Optional multi-model menu. Copy engines.example.json and edit its private
# backend addresses when the render engines run on different hosts.
FVL_ENGINES_FILE=/opt/Frosty-VL-Deploy/config/engines.example.json
